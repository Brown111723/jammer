# From https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Must match the redirect URI registered on your Spotify app EXACTLY.
# Spotify no longer accepts the hostname "localhost" — use the loopback IP.
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Where the Python analyzer service is listening.
NEXT_PUBLIC_ANALYZER_URL=http://127.0.0.1:8000

# Optional: enables YouTube search. Free from the Google Cloud console:
#   https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Pasting a YouTube / YouTube Music link works WITHOUT this.
# Quota is 10,000 units/day and a search costs 100 — about 100 searches.
NEXT_PUBLIC_YOUTUBE_API_KEY=

# Optional: sign in to see your own YouTube Music playlists and liked songs.
#
# In the Google Cloud console (https://console.cloud.google.com):
#   1. Enable "YouTube Data API v3" for the project.
#   2. Credentials -> Create credentials -> OAuth client ID -> Web application.
#   3. Authorised redirect URI: http://127.0.0.1:3000/youtube/callback
#   4. Put the client ID in BOTH vars below (the NEXT_PUBLIC_ one reaches the browser
#      for the redirect; the plain one is used by the server-side token exchange).
#
# NOTE: unlike Spotify, Google requires a client SECRET even with PKCE, so the token
# exchange runs server-side in /api/youtube/token. YOUTUBE_CLIENT_SECRET must NOT have
# a NEXT_PUBLIC_ prefix — that prefix would inline it into the browser bundle.
NEXT_PUBLIC_YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
