# From https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Must match the redirect URI registered on your Spotify app EXACTLY.
# Spotify no longer accepts the hostname "localhost" — use the loopback IP.
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Where the Python analyzer service is listening.
NEXT_PUBLIC_ANALYZER_URL=http://127.0.0.1:8000

# Optional: enables YouTube search. Free from the Google Cloud console:
#   https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Pasting a YouTube / YouTube Music link works WITHOUT this.
# Quota is 10,000 units/day and a search costs 100 — about 100 searches.
NEXT_PUBLIC_YOUTUBE_API_KEY=
